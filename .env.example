GROQ_API_KEY=your_key_here
WEALTH_ENGINE_URL=http://localhost:8001
FRAUD_ENGINE_URL=http://localhost:8002
CHAT_SERVICE_URL=http://localhost:8003
API_GATEWAY_URL=http://localhost:8000

# Zero-Trust inter-service shared secret.
# Every Python service verifies the X-Internal-Token header against this
# value; the API gateway (Member 4) must inject it on every proxy call.
# Change this to a strong random value in production.
INTERNAL_SECRET=swt-2026

# JWT signing secret for the API gateway. Change this to a strong random
# value in production — never ship the default.
JWT_SECRET=changeme

# Comma-separated list of origins allowed to call the gateway/services.
CORS_ORIGINS=http://localhost:3000,http://localhost:8100